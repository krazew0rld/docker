{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cd50/image",
	"version": "0.1.0",
	"title": "Image",
	"category": "block-custom",
	"icon": "smiley",
	"description": "",
	"example": {},
	"supports": {
		"html": false
	},
	"textdomain": "cd50",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"attributes": {
		"file": {
			"type": "object",
			"default": null
		},
		"size": {
			"type": "number",
			"default": 0
		},
		"align": {
			"type": "string",
			"default": "left"
		},
		"isZoomable": {
			"type": "boolean",
			"default": false
		}
	}
}